org.springframework.aot.hint.RuntimeHintsRegistrar=\
io.github.dengchen2020.aot.AllRuntimeHintsRegistrar, \
io.github.dengchen2020.aot.DcRuntimeHintsRegistrar

org.springframework.beans.factory.aot.BeanFactoryInitializationAotProcessor=\
io.github.dengchen2020.core.aot.ControllerParameterBindingHintsAotProcessor,\
io.github.dengchen2020.core.aot.JavaBeansHintsAotProcessor
